<resources>
<!--  Existing main application theme  -->
<style name="Base.Theme.UnitConvertor" parent="Theme.Material3.DayNight.NoActionBar">
<item name="colorPrimary">#2563EB</item>
<item name="colorOnPrimary">#FFFFFF</item>
<item name="android:statusBarColor">#2563EB</item>
<item name="android:navigationBarColor">#FFFFFF</item>
<item name="android:windowLightNavigationBar">true</item>
<item name="android:windowActionModeOverlay">true</item>
</style>
<style name="Theme.UnitConvertor" parent="Base.Theme.UnitConvertor"/>
<!--  Theme displayed while the app starts  -->
<style name="Theme.UnitConvertor.Starting" parent="Theme.SplashScreen">
<item name="windowSplashScreenBackground">#2563EB</item>
<item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
<item name="postSplashScreenTheme">@style/Theme.UnitConvertor</item>
</style>
</resources>
